generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum AccountType {
  TRAVELER
  TRANSPORTER
}

enum TransportType {
  CAR
  BUS
  VAN
  MINIBUS
  TRUCK
}

enum TransportStatus {
  ACTIVE
  INACTIVE
  FULL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentMethod {
  PAYSTACK
  FLUTTERWAVE
  MPAISA
}

// Admin role tiers. SUPER_ADMIN bypasses all permission checks.
// Other tiers must have explicit permissions[] entries.
enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
}

// Audience an announcement is shown to. Public endpoint filters by this.
enum AnnouncementAudience {
  ALL
  TRAVELERS_ONLY
  TRANSPORTERS_ONLY
}

// Lifecycle of a transporter payout. Terminal states are RELEASED + FAILED.
enum PayoutStatus {
  PENDING     // arrival confirmed, awaiting release
  PROCESSING  // Paystack transfer initiated, not yet final
  RELEASED    // funds confirmed in transporter's bank
  FAILED      // transfer failed; admin can retry
}

// Why the payout was actually triggered. Captured the first time
// attemptRelease() runs against a payout — answers "did the platform
// release this on its own, or did a human admin click the button?"
enum PayoutTrigger {
  AUTO    // PlatformSettings.autoPayoutEnabled fired this on arrival confirmation
  MANUAL  // an admin hit /admin/payouts/:id/release
}

enum BugReportKind {
  BUG          // user is reporting something broken
  SUGGESTION   // user is suggesting an improvement
}

enum BugReportStatus {
  OPEN         // submitted, no admin reply yet
  REPLIED      // admin has responded (terminal for the simple flow)
  CLOSED       // admin marked it done without replying
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  name           String?
  phoneNumber    String?
  country        String?
  avatarUrl      String?
  profileImageUrl String?      // For transporters
  passwordHash   String?
  role           Role         @default(USER)
  accountType    AccountType?
  emailVerified     Boolean   @default(false)
  emailVerifiedAt   DateTime?
  preferredCurrency String?   // ISO 4217 code (e.g. "NGN", "GHS", "USD")

  // Transporter payout settings. The bank* + paystackRecipientCode columns
  // are the Paystack-side account; the flw* columns are the Flutterwave-side
  // account. A transporter can have either, both, or neither. The release
  // pipeline picks the right column set based on which provider the booking
  // was paid through (matches money-in to money-out so we don't accidentally
  // pay from a balance that doesn't have the corresponding deposit).
  //
  // Paystack-side
  bankCode             String?  // Paystack bank code (e.g. NIP code for Nigerian banks)
  bankAccountNumber    String?
  bankAccountName      String?
  paystackRecipientCode String? @unique // returned by POST /transferrecipient
  // Flutterwave-side. Flutterwave doesn't have a recipient concept — bank
  // code + account number are passed directly on each transfer call.
  flwBankCode          String?
  flwBankAccountNumber String?
  flwBankAccountName   String?
  // "Preferred" provider when both are configured. Mostly informational now —
  // actual release uses the same provider the booking was charged through.
  payoutProvider       PaymentMethod?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  authProviders  AuthProvider[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordResetToken[]
  verificationOtps EmailVerificationOtp[]
  profile        UserProfile?
  transports     Transport[]
  bookings       Booking[]            @relation("TravelerBookings")
  vehicles       Vehicle[]
  reviewsGiven   Review[]             @relation("TravelerReviews")
  reviewsReceived Review[]            @relation("TransporterReviews")
  travelerChats  Chat[]               @relation("TravelerChats")
  transporterChats Chat[]             @relation("TransporterChats")
  messages       Message[]
  siteFeedback   SiteFeedback[]
  payouts        Payout[]             @relation("TransporterPayouts")
  bugReports     BugReport[]          @relation("BugReportAuthor")
}

model AuthProvider {
  id         String   @id @default(uuid())
  provider   String
  providerId String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([provider, providerId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model EmailVerificationOtp {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  used       Boolean  @default(false)
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([userId])
}

model UserProfile {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio                     String?
  dateOfBirth             DateTime?

  travelerBio             String?
  emergencyContactName    String?
  emergencyContactPhone   String?

  companyName             String?
  licenseNumber           String?
  licenseExpiry           DateTime?
  vehicleType             String?

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  emergencyContacts       EmergencyContact[]
  notificationPreferences NotificationPreferences?
}

model EmergencyContact {
  id        String   @id @default(uuid())
  profileId String
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  name      String
  relation  String
  phone     String
  verified  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vehicle {
  id            String   @id @default(uuid())
  transporterId String
  transporter   User     @relation(fields: [transporterId], references: [id], onDelete: Cascade)

  name          String
  model         String
  plateNumber   String
  transportType TransportType
  imageUrl      String?
  deleted       Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transports    Transport[]
}

model Transport {
  id                 String          @id @default(uuid())
  transporterId      String
  transporter        User            @relation(fields: [transporterId], references: [id], onDelete: Cascade)
  vehicleId          String
  vehicle            Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  departureCountry   String
  departureCity      String
  destinationCountry String
  destinationCity    String
  transportType      TransportType

  price              Decimal         @db.Decimal(10, 2)
  currency           String          @default("USD") // ISO 4217 code — what the `price` is denominated in
  availableSeats     Int
  departureDateTime  DateTime
  maxReachDateTime   DateTime

  // Group-ride threshold. Until `minSeatsToConfirm` worth of seats are
  // booked across non-cancelled bookings, the trip is "filling" — pay is
  // locked and travelers see a progress meter. Null on routes that don't
  // care about a minimum (existing rows are backfilled to capacity at
  // migration time, so they keep behaving like single-seat-per-confirm).
  minSeatsToConfirm  Int?
  // When true, every PENDING booking auto-flips to CONFIRMED the moment
  // the threshold is reached — payment unlocks immediately for everyone.
  // When false, the transporter still confirms each booking manually,
  // but their Confirm button doesn't fire until the threshold is met
  // (overridable; see BookingService for the manual-override path).
  autoConfirmOnFill  Boolean         @default(false)

  status             TransportStatus @default(ACTIVE)

  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  bookings           Booking[]
}

model Booking {
  id            String        @id @default(uuid())
  travelerId    String
  traveler      User          @relation("TravelerBookings", fields: [travelerId], references: [id], onDelete: Cascade)
  transportId   String
  transport     Transport     @relation(fields: [transportId], references: [id], onDelete: Cascade)

  seatsBooked   Int
  totalPrice    Decimal       @db.Decimal(10, 2)

  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod?

  // 10-digit code traveler shows the transporter at pickup. Encoded into the
  // QR shown on the traveler's booking detail page. Generated on booking
  // create (so the code exists even if the booking is unpaid for a while).
  // Unique so the code alone is enough to identify a booking server-side.
  verificationCode String?    @unique

  // Stamped when the transporter scans/enters the code → trip is in progress.
  pickupVerifiedAt DateTime?

  // Stamped when the traveler clicks "I've arrived" → trip is COMPLETED and
  // the payout from the platform's escrow to the transporter is queued.
  arrivalConfirmedAt DateTime?

  // Stamped when the TRANSPORTER pre-flags the trip as completed. Status
  // stays IN_PROGRESS until the traveler confirms — prevents fraud where a
  // transporter could fake-complete a trip to trigger their own payout
  // without the traveler actually having arrived. The traveler's "I've
  // arrived" action is what flips status to COMPLETED.
  completionRequestedAt DateTime?

  payments      Payment[]
  payout        Payout?

  review        Review?
  chat          Chat?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model NotificationPreferences {
  id                    String   @id @default(uuid())
  profileId             String   @unique
  profile               UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  pushEnabled           Boolean  @default(true)
  bookingUpdates        Boolean  @default(true)
  paymentUpdates        Boolean  @default(true)
  routeUpdates          Boolean  @default(true)
  vehicleUpdates        Boolean  @default(true)
  systemAnnouncements   Boolean  @default(true)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Review {
  id            String   @id @default(uuid())
  bookingId     String   @unique
  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  travelerId    String
  traveler      User     @relation("TravelerReviews", fields: [travelerId], references: [id], onDelete: Cascade)

  transporterId String
  transporter   User     @relation("TransporterReviews", fields: [transporterId], references: [id], onDelete: Cascade)

  rating        Int
  feedback      String?

  createdAt     DateTime @default(now())

  @@index([transporterId])
  @@index([travelerId])
}

// Site-wide feedback about SmatWay itself (distinct from per-booking Review).
// Submitted from the dashboard /feedback page; surfaced on the marketing
// homepage Testimonials rotator alongside trip reviews.
// User-submitted bug reports & improvement suggestions. Travelers and
// transporters share the same model — `kind` distinguishes them. Optional
// image attachments are stored as S3 keys (resolve via storageService at
// read time). Single admin reply for the simple flow; if a thread becomes
// necessary later, promote `adminReply` to a child Reply[] relation.
model BugReport {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation("BugReportAuthor", fields: [userId], references: [id], onDelete: Cascade)

  kind           BugReportKind
  subject        String
  body           String           @db.Text
  imageKeys      String[]         @default([])  // S3 object keys, resolve to presigned URLs on read

  status         BugReportStatus  @default(OPEN)

  // Single admin reply. Stays null until an admin responds.
  adminReply     String?          @db.Text
  repliedAt      DateTime?
  repliedByAdminId String?

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model SiteFeedback {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating    Int      // 1..5
  comment   String

  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Chat {
  id            String    @id @default(uuid())
  bookingId     String    @unique
  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  travelerId    String
  traveler      User      @relation("TravelerChats", fields: [travelerId], references: [id], onDelete: Cascade)

  transporterId String
  transporter   User      @relation("TransporterChats", fields: [transporterId], references: [id], onDelete: Cascade)

  messages      Message[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([bookingId])
  @@index([travelerId])
  @@index([transporterId])
}

model Message {
  id        String   @id @default(uuid())
  chatId    String
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  content   String
  createdAt DateTime @default(now())

  @@index([chatId])
  @@index([senderId])
}

// ─── Admin domain ────────────────────────────────────────────────────────────
// Separate from User: admins are platform operators, not travelers/transporters.
// Authenticated against ADMIN_JWT_SECRET (separate secret from user JWTs).

model Admin {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String
  role          AdminRole @default(ADMIN)

  // Fine-grained permission strings (e.g. "users:read", "finance:refund").
  // SUPER_ADMIN ignores this and is allowed everything.
  permissions   String[]  @default([])

  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Self-relation: which admin created this one (null for the bootstrap admin)
  createdById   String?
  createdBy     Admin?    @relation("AdminCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAdmins Admin[]   @relation("AdminCreator")

  auditLogs     AdminAuditLog[]
  inviteTokens  AdminInviteToken[]
  announcements Announcement[]

  @@index([email])
  @@index([role])
}

// Append-only audit trail of admin write actions. Read by the audit log page.
model AdminAuditLog {
  id          String   @id @default(uuid())

  // Nullable so the env-bypass SUPER_ADMIN (no DB row) can still log actions.
  adminId     String?
  admin       Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)

  // Marker for the env-bypass admin so audit rows aren't anonymous when adminId is null.
  adminLabel  String   // either Admin.username, or "ENV_SUPERADMIN" for env logins

  action      String   // e.g. "user.suspend", "feedback.delete", "admin.create"
  targetType  String?  // "User" | "Transport" | "Admin" | …
  targetId    String?

  // Snapshot of payload / before/after / anything useful for forensics.
  metadata    Json?

  ipAddress   String?
  userAgent   String?

  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

// One-time tokens issued when an admin invites another admin via email.
// Used only when OTP_SEND_EMAIL=true; otherwise admins are created with a
// password directly.
model AdminInviteToken {
  id          String    @id @default(uuid())
  adminId     String
  admin       Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  token       String    @unique
  expiresAt   DateTime
  usedAt      DateTime?

  createdAt   DateTime  @default(now())

  @@index([token])
  @@index([adminId])
}

// Payment attempt against a booking. One booking may have multiple Payment
// rows (e.g. user retried after a failure). Reference is provider-side and
// uniquely identifies the transaction in our DB. Raw response stores the full
// provider payload for forensics / dispute resolution.
model Payment {
  id            String         @id @default(uuid())
  bookingId     String
  booking       Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  provider      PaymentMethod  // PAYSTACK / FLUTTERWAVE / MPAISA
  reference     String         @unique  // provider-side transaction reference

  amount        Decimal        @db.Decimal(10, 2)
  currency      String

  status        PaymentStatus  @default(PENDING)

  // Provider-specific raw payload (init response + webhook + verify) — kept
  // as one Json column for simplicity. Useful for audits & support tickets.
  rawResponse   Json?

  initializedAt DateTime       @default(now())
  paidAt        DateTime?
  failedAt      DateTime?

  @@index([bookingId])
  @@index([status])
}

// Payout from the platform's escrow account to the transporter, triggered
// when the traveler confirms arrival. One payout per booking. Tracks the
// commission split (platform takes commissionRate × gross) and the Paystack
// Transfers API state (recipient_code → transfer_code → final settlement).
model Payout {
  id              String       @id @default(uuid())
  bookingId       String       @unique
  booking         Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  transporterId   String
  transporter     User         @relation("TransporterPayouts", fields: [transporterId], references: [id], onDelete: Cascade)

  grossAmount      Decimal     @db.Decimal(10, 2) // booking total
  commissionRate   Decimal     @db.Decimal(5, 4)  // 0.1000 = 10% — captured at payout time
  commissionAmount Decimal     @db.Decimal(10, 2)
  netAmount        Decimal     @db.Decimal(10, 2) // gross - commission, what transporter receives
  currency         String

  status          PayoutStatus @default(PENDING)

  // Which provider this payout was actually sent through (snapshot at
  // attempt-release time). Lets us reconcile against the right API later
  // even if the transporter changes their preferred provider afterwards.
  provider        PaymentMethod?

  // Paystack-specific identifiers (populated as the transfer progresses).
  paystackRecipientCode     String?
  paystackTransferCode      String?
  paystackTransferReference String?  @unique  // our reference for idempotency

  // Flutterwave-specific identifier (their /transfers returns a numeric id).
  flwTransferId             Int?

  // How this payout was triggered (set the first time attemptRelease runs).
  // Nullable because pre-existing rows from before this column was added
  // never recorded a trigger; PENDING rows are also null until they're
  // attempted. Display layer treats null as "unknown / legacy".
  releaseTrigger  PayoutTrigger?

  rawResponse               Json?

  createdAt   DateTime  @default(now())
  releasedAt  DateTime?
  failedAt    DateTime?
  failureReason String?

  @@index([transporterId])
  @@index([status])
  @@index([createdAt])
}

// Singleton table for platform-wide settings that admins can edit at runtime.
// One row, id=1 (seeded by migration). Use commissionRate + autoPayoutEnabled
// from this table — the matching env vars (PLATFORM_COMMISSION_RATE,
// PAYSTACK_AUTO_PAYOUT) are kept only as fallbacks for the very first boot
// before the row is read.
model PlatformSettings {
  id                  Int      @id @default(1)
  commissionRate      Decimal  @db.Decimal(5, 4) @default(0.1000)  // 0.1 = 10%
  autoPayoutEnabled   Boolean  @default(false)
  updatedAt           DateTime @updatedAt
  updatedByAdminId    String?  // who last touched it (audit linkage)
}

// Platform-wide announcements posted by admins. Surfaced in the user-side
// /dashboard/announcements pages, filtered by audience.
model Announcement {
  id              String                @id @default(uuid())
  title           String
  body            String
  audience        AnnouncementAudience  @default(ALL)
  isPublished     Boolean               @default(true)

  // S3 keys for any images attached at create time. Resolve to presigned
  // URLs on read via storageService.resolveImageUrl(). Empty array = no
  // attachments — same shape as BugReport.imageKeys.
  imageKeys       String[]              @default([])

  // When this announcement should drop off the public feed automatically.
  // Default 7 days from creation, set explicitly by the admin form. Null
  // means "never expire" — kept open in case super-admins want to pin a
  // permanent banner.
  expiresAt       DateTime?

  createdByAdminId String?
  createdByAdmin   Admin?               @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([audience])
  @@index([isPublished, createdAt])
  @@index([expiresAt])
}
